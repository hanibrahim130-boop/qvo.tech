{
  "name": "scroll-scrub-video",
  "version": "0.1.0",
  "description": "Scroll-scrubbed background video and reveal-on-scroll primitives for React. Scrolling seeks the video instead of playing it.",
  "keywords": [
    "react",
    "scroll",
    "scrollytelling",
    "video",
    "scrub",
    "animation",
    "intersection-observer",
    "motion"
  ],
  "license": "MIT",
  "author": "QVO (https://qvo.tech)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanibrahim130-boop/qvo.tech.git",
    "directory": "packages/scroll-scrub-video"
  },
  "homepage": "https://github.com/hanibrahim130-boop/qvo.tech/tree/main/packages/scroll-scrub-video",
  "bugs": {
    "url": "https://github.com/hanibrahim130-boop/qvo.tech/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --external react --external react-dom --clean && tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
